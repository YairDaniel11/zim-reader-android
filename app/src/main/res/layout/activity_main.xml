<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zrBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/zrHeader"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnRescan"
            style="@style/BarButton"
            android:contentDescription="סרוק מחדש"
            android:src="@drawable/ic_refresh"
            android:nextFocusDown="@+id/list"
            android:nextFocusLeft="@+id/btnBookmarks"
            android:nextFocusRight="@+id/btnRescan"
            android:nextFocusUp="@id/btnRescan" />

        <ImageButton
            android:id="@+id/btnBookmarks"
            style="@style/BarButton"
            android:contentDescription="סימניות"
            android:src="@drawable/ic_bookmark"
            android:nextFocusDown="@+id/list"
            android:nextFocusLeft="@+id/btnHistory"
            android:nextFocusRight="@+id/btnRescan"
            android:nextFocusUp="@id/btnBookmarks" />

        <ImageButton
            android:id="@+id/btnHistory"
            style="@style/BarButton"
            android:contentDescription="היסטוריה"
            android:src="@drawable/ic_history"
            android:nextFocusDown="@+id/list"
            android:nextFocusLeft="@+id/btnHistory"
            android:nextFocusRight="@+id/btnBookmarks"
            android:nextFocusUp="@id/btnHistory" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textColor="?attr/zrTextSecondary"
        android:textSize="17sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#22000000"
        android:dividerHeight="1dp"
        android:listSelector="@drawable/list_selector"
        android:nextFocusUp="@id/btnRescan" />
</LinearLayout>
