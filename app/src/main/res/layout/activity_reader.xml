<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zrBg">

    <il.zimreader.ZimWebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:nextFocusUp="@+id/btnHome" />

    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="top"
        android:layout_marginTop="56dp"
        android:background="?attr/zrRow"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="חיפוש בדף"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="?attr/zrText"
            android:textColorHint="?attr/zrTextSecondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:gravity="center"
            android:textColor="?attr/zrTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/findPrev"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▲"
            android:textColor="?attr/zrText"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/findNext"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▼"
            android:textColor="?attr/zrText"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/findClose"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✕"
            android:textColor="?attr/zrText"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="?attr/zrHeader"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnTabs"
            style="@style/BarButton"
            android:contentDescription="כרטיסיות"
            android:src="@drawable/ic_tabs"
            android:nextFocusLeft="@+id/btnHome"
            android:nextFocusRight="@+id/btnTabs"
            android:nextFocusUp="@id/btnTabs"
            android:nextFocusDown="@+id/web" />

        <ImageButton
            android:id="@+id/btnHome"
            style="@style/BarButton"
            android:contentDescription="דף ראשי"
            android:src="@drawable/ic_home"
            android:nextFocusLeft="@+id/btnSearch"
            android:nextFocusRight="@+id/btnTabs"
            android:nextFocusUp="@id/btnHome"
            android:nextFocusDown="@+id/web" />

        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/BarButton"
            android:contentDescription="חיפוש"
            android:src="@drawable/ic_search"
            android:nextFocusLeft="@+id/btnBookmark"
            android:nextFocusRight="@+id/btnHome"
            android:nextFocusUp="@id/btnSearch"
            android:nextFocusDown="@+id/web" />

        <ImageButton
            android:id="@+id/btnBookmark"
            style="@style/BarButton"
            android:contentDescription="סימנייה"
            android:src="@drawable/ic_bookmark"
            android:nextFocusLeft="@+id/btnLibrary"
            android:nextFocusRight="@+id/btnSearch"
            android:nextFocusUp="@id/btnBookmark"
            android:nextFocusDown="@+id/web" />

        <ImageButton
            android:id="@+id/btnLibrary"
            style="@style/BarButton"
            android:contentDescription="ספרים"
            android:src="@drawable/ic_library"
            android:nextFocusLeft="@+id/btnMenu"
            android:nextFocusRight="@+id/btnBookmark"
            android:nextFocusUp="@id/btnLibrary"
            android:nextFocusDown="@+id/web" />

        <ImageButton
            android:id="@+id/btnMenu"
            style="@style/BarButton"
            android:contentDescription="תפריט"
            android:src="@drawable/ic_more"
            android:nextFocusLeft="@+id/btnMenu"
            android:nextFocusRight="@+id/btnLibrary"
            android:nextFocusUp="@id/btnMenu"
            android:nextFocusDown="@+id/web" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="bottom"
        android:background="?attr/zrHeader"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#FFBDBDBD"
        android:textSize="11sp" />
</FrameLayout>
