<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zrBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/zrHeader"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnHome"
            style="@style/BarButton"
            android:contentDescription="דף ראשי"
            android:src="@drawable/ic_home"
            android:focusable="false" />

        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/BarButton"
            android:contentDescription="חיפוש"
            android:src="@drawable/ic_search"
            android:focusable="false" />

        <ImageButton
            android:id="@+id/btnBookmark"
            style="@style/BarButton"
            android:contentDescription="סימנייה"
            android:src="@drawable/ic_bookmark"
            android:focusable="false" />

        <ImageButton
            android:id="@+id/btnMenu"
            style="@style/BarButton"
            android:contentDescription="תפריט"
            android:src="@drawable/ic_more"
            android:focusable="false" />
    </LinearLayout>

    <!-- הכפתורים למגע בלבד; במקשים: * חיפוש, # או MENU תפריט, חצים לגלילה -->
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
