<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/zrBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/zrHeader"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnHome"
            style="@style/BarButton"
            android:contentDescription="דף ראשי"
            android:src="@drawable/ic_home"
            android:nextFocusLeft="@+id/btnSearch"
            android:nextFocusRight="@+id/btnHome"
            android:nextFocusUp="@id/btnHome"
            android:nextFocusDown="@+id/web" />

        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/BarButton"
            android:contentDescription="חיפוש"
            android:src="@drawable/ic_search"
            android:nextFocusLeft="@+id/btnBookmark"
            android:nextFocusRight="@+id/btnHome"
            android:nextFocusUp="@id/btnSearch"
            android:nextFocusDown="@+id/web" />

        <ImageButton
            android:id="@+id/btnBookmark"
            style="@style/BarButton"
            android:contentDescription="סימנייה"
            android:src="@drawable/ic_bookmark"
            android:nextFocusLeft="@+id/btnLibrary"
            android:nextFocusRight="@+id/btnSearch"
            android:nextFocusUp="@id/btnBookmark"
            android:nextFocusDown="@+id/web" />

        <ImageButton
            android:id="@+id/btnLibrary"
            style="@style/BarButton"
            android:contentDescription="ספרים"
            android:src="@drawable/ic_library"
            android:nextFocusLeft="@+id/btnMenu"
            android:nextFocusRight="@+id/btnBookmark"
            android:nextFocusUp="@id/btnLibrary"
            android:nextFocusDown="@+id/web" />

        <ImageButton
            android:id="@+id/btnMenu"
            style="@style/BarButton"
            android:contentDescription="תפריט"
            android:src="@drawable/ic_more"
            android:nextFocusLeft="@+id/btnMenu"
            android:nextFocusRight="@+id/btnLibrary"
            android:nextFocusUp="@id/btnMenu"
            android:nextFocusDown="@+id/web" />
    </LinearLayout>

    <il.zimreader.ZimWebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:nextFocusUp="@id/btnHome" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/zrHeader"
        android:ellipsize="end"
        android:gravity="center"
        android:padding="4dp"
        android:singleLine="true"
        android:textColor="#FFBDBDBD"
        android:textSize="11sp" />
</LinearLayout>
